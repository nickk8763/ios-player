<?xml version="1.0" encoding="utf-8"?>
<!--
  widget_control_in.xml — Animação de entrada do ícone Play/Pause no ViewFlipper.
  Referência: LockScreenPlayerCard.kt:712-716 (fadeIn + scaleIn(initialScale=0.8f))
  Duração: 220ms (compatível com IconTransitionSpring do MotionSpec.kt)
-->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/decelerate_quint">
    <alpha
        android:fromAlpha="0.0"
        android:toAlpha="1.0"
        android:duration="220" />
    <scale
        android:fromXScale="0.8"
        android:fromYScale="0.8"
        android:toXScale="1.0"
        android:toYScale="1.0"
        android:pivotX="50%"
        android:pivotY="50%"
        android:duration="220" />
</set>
