<?xml version="1.0" encoding="utf-8"?>
<!--
  widget_control_out.xml — Animação de saída do ícone Play/Pause no ViewFlipper.
  Referência: LockScreenPlayerCard.kt:717-721 (fadeOut + scaleOut(targetScale=0.8f))
  Duração: 220ms (compatível com IconTransitionSpring do MotionSpec.kt)
-->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/decelerate_quint">
    <alpha
        android:fromAlpha="1.0"
        android:toAlpha="0.0"
        android:duration="220" />
    <scale
        android:fromXScale="1.0"
        android:fromYScale="1.0"
        android:toXScale="0.8"
        android:toYScale="0.8"
        android:pivotX="50%"
        android:pivotY="50%"
        android:duration="220" />
</set>
