<?xml version="1.0" encoding="utf-8"?>
<!--
  widget_glass_bg.xml — Fallback Clear Liquid Glass (25dp corners).
  Used as initialLayout background before PlayerWidgetProvider renders
  the density-accurate specular glass overlay bitmap for exact widget width.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="25dp" />
    <gradient
        android:angle="270"
        android:startColor="#26FFFFFF"
        android:centerColor="#1A0E1218"
        android:endColor="#29080A0E" />
    <stroke
        android:width="0.75dp"
        android:color="#7AFFFFFF" />
</shape>
